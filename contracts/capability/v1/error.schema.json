{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logforce.github.io/contracts/capability/v1/error.schema.json",
  "title": "ecOS Capability Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "enum": [
        "unsupported",
        "invalid_input",
        "schema_mismatch",
        "policy_denied",
        "unavailable",
        "busy",
        "timeout",
        "cancelled",
        "internal"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retryable": { "type": "boolean" },
    "diagnostic_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
